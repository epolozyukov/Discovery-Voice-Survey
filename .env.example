NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed to use /admin (also disable public signups in Supabase Auth)
ADMIN_EMAILS=
# Public base URL used when building participant links (optional; defaults to request origin)
NEXT_PUBLIC_APP_URL=
# Optional limits
NEXT_PUBLIC_MAX_ANSWER_LENGTH=10000
NEXT_PUBLIC_MAX_RECORDING_SECONDS=300
# Speech-to-text (any OpenAI-compatible /audio/transcriptions endpoint: OpenAI, Groq, self-hosted faster-whisper). Server-side only.
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
# Set to "mock" for deterministic tests (no network, no microphone transcription)
NEXT_PUBLIC_TRANSCRIPTION_PROVIDER=
